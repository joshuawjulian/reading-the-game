{
  "name": "Reading the Game (Python + Quarto)",
  "build": { "dockerfile": "Dockerfile", "context": ".." },
  "workspaceFolder": "/workspaces/course",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/course,type=bind,consistency=cached",
  "remoteUser": "dev",
  "customizations": {
    "vscode": {
      "extensions": [
        "quarto.quarto", "ms-python.python", "ms-python.vscode-pylance",
        "charliermarsh.ruff", "ms-toolsai.jupyter", "tamasfe.even-better-toml"
      ],
      "settings": { "python.defaultInterpreterPath": "/opt/venv/bin/python" }
    }
  },
  "postCreateCommand": "uv sync && quarto --version && python --version"
}
